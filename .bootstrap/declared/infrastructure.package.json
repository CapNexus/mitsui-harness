{
  "name": "project-mep-aws-infrastructure",
  "private": true,
  "description": "Declared toolchain from ENGINEERING-STANDARDS.md (staged for harness-bootstrap; F02-S02 creates the real file)",
  "engines": { "node": ">=20" },
  "bin": { "infra": "bin/app.ts" },
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc --noEmit",
    "test": "jest --coverage",
    "synth": "cdk synth --quiet"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "collectCoverageFrom": ["lib/**/*.ts", "bin/**/*.ts"],
    "coverageThreshold": { "global": { "lines": 80, "branches": 80, "functions": 80, "statements": 80 } }
  },
  "dependencies": { "aws-cdk-lib": "^2.170.0", "constructs": "^10.4.0", "cdk-nag": "^2.34.0" },
  "devDependencies": {
    "aws-cdk": "^2.170.0", "typescript": "^5.6.0", "ts-node": "^10.9.2",
    "jest": "^29.7.0", "ts-jest": "^29.2.0", "@types/jest": "^29.5.0", "@types/node": "^20.0.0",
    "eslint": "^9.15.0", "typescript-eslint": "^8.15.0", "prettier": "^3.3.0"
  }
}
