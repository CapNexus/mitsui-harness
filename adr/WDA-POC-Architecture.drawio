<mxCell id="entra_txt" value="&lt;b&gt;Microsoft Entra ID (Mitsui admin: Matt Schiefelbein)&lt;/b&gt;&lt;br&gt;Groups: sg-wda-users-well / -geo / -econ, sg-wda-econ-sensitive,&lt;br&gt;sg-wda-itpmo-tools, sg-wda-admins, sg-wda-capnexus-engineers&lt;br&gt;App registrations: WDA-API (audience), WDA-TeamsBot (single tenant),&lt;br&gt;WDA-Clients (public client)&lt;br&gt;Conditional Access and MFA apply by group. Entra ID P1 or higher needed&lt;br&gt;for group assignment and SCIM provisioning." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="1500" y="45" width="470" height="175" as="geometry"/></mxCell>
<mxCell id="entra" value="Microsoft Entra ID" style="aspect=fixed;html=1;fontSize=11;fontColor=#232F3E;image;image=img/lib/azure2/identity/Azure_Active_Directory.svg;verticalLabelPosition=top;verticalAlign=bottom;align=center;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2040" y="80" width="60" height="60" as="geometry"/></mxCell>
