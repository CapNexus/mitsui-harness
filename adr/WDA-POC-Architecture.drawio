<mxCell id="lgt2" value="Identity and token path (I1 to I3)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="110" y="368" width="280" height="20" as="geometry"/></mxCell>
<mxCell id="lg3" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#7D8998;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="40" y="406" as="sourcePoint"/><mxPoint x="100" y="406" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="lgt3" value="Audit and log path (A1, A2)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="110" y="396" width="280" height="20" as="geometry"/></mxCell>
<mxCell id="facts" value="&lt;b&gt;Key facts&lt;/b&gt;&lt;br&gt;• Region: us-east-1, US only. Claude cross-Region inference stays in us-east-1, us-east-2, us-west-2.&lt;br&gt;• Data: about 15.4 GB from 3 SQL Server 2017 databases, daily one-way full load. No change data capture.&lt;br&gt;• Read-only by design: AgentCore Policy (SELECT only, row limit, timeout) and Lake Formation both refuse writes.&lt;br&gt;• The assistant has no network path to the on-premises databases. Only the DMS subnet routes to the VPN.&lt;br&gt;• Every query runs as, and is logged against, the signed-in user.&lt;br&gt;• Targets: 80% of about 30 questions correct, Teams answers in 60 s, about 15 pilot users, load unattended for the final 2 weeks.&lt;br&gt;• Out of scope: Quorum and other APIs, QLS/LIS, Oracle, querying in place, CDC, HA, map rendering." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="360" height="325" as="geometry"/></mxCell>
<mxCell id="palo" value="Palo Alto firewall / VPN&lt;br&gt;(customer gateway)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.customer_gateway;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="db_well" value="MEPWELL&lt;br&gt;well hub&lt;br&gt;~0.2 GB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.generic_database;" vertex="1" parent="1"><mxGeometry x="76" y="1040" width="47" height="62" as="geometry"/></mxCell>
<mxCell id="db_sde" value="SDEDBPROD&lt;br&gt;GIS&lt;br&gt;~10 GB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.generic_database;" vertex="1" parent="1"><mxGeometry x="186" y="1040" width="47" height="62" as="geometry"/></mxCell>
<mxCell id="db_aries" value="MEPS_ARIES&lt;br&gt;ARIES&lt;br&gt;~5 GB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.generic_database;" vertex="1" parent="1"><mxGeometry x="296" y="1040" width="47" height="62" as="geometry"/></mxCell>
<mxCell id="dc_note" value="• Read-only login dms_wda_ro per database (db_datareader, VIEW DATABASE STATE, VIEW DEFINITION). Never sysadmin or db_owner.&lt;br&gt;• SDEDBPROD: GIS admin compresses to state 0 before each load, or DMS reads versioned _evw views (decision open).&lt;br&gt;• Firewall: only the DMS subnet, fixed TCP port per instance (default 1433). Mitsui owns this side of the VPN." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="340" height="190" as="geometry"/></mxCell>
<mxCell id="idc" value="IAM Identity Center&lt;br&gt;(org instance)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="1"><mxGeometry x="2040" y="380" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="ct" value="Control Tower&lt;br&gt;landing zone" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.control_tower;" vertex="1" parent="1"><mxGeometry x="2200" y="380" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="orgs" value="Organizations" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1" parent="1"><mxGeometry x="2340" y="380" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="mgmt_note" value="Entra ID is the external identity provider (SAML sign-in, SCIM sync). A trusted token issuer for the Entra tenant enables identity propagation to Athena and Lake Formation.&lt;br&gt;Temporary cross-account role (AdministratorAccess, MFA and external ID, 4 h sessions, 7-day expiry) is deleted after the Control Tower launch in Week 1. Root credentials stay with Mitsui." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="2015" y="490" width="435" height="150" as="geometry"/></mxCell>
<mxCell id="la_s3" value="Log archive&lt;br&gt;S3 bucket" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="2030" y="710" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="la_ct" value="Organization&lt;br&gt;trail" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1"><mxGeometry x="2200" y="710" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="la_cfg" value="AWS Config" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.config;" vertex="1" parent="1"><mxGeometry x="2340" y="710" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="au_sns" value="Control Tower&lt;br&gt;notifications" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;labelBackgroundColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="2030" y="925" width="60" height="60" as="geometry"/></mxCell>
<mxCell id="au_note" value="Read-only audit access to member accounts for Mitsui security staff." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="2150" y="925" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="guard" value="&lt;b&gt;Landing zone guardrails&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B7C0;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacing=6;dashed=0;" vertex="1" parent="1"><mxGeometry x="2000" y="1050" width="460" height="370" as="geometry"/></mxCell>
<mxCell id="guard_txt" value="• OUs: Security (Log Archive, Audit) and Workloads (POC account).&lt;br&gt;• Control Tower default controls, organization trail, AWS Config.&lt;br&gt;• Region-deny control allows only us-east-1, us-east-2 and us-west-2, so Claude cross-Region inference works and data stays in the US.&lt;br&gt;• Account emails: three Mitsui distribution lists (Log Archive, Audit, POC).&lt;br&gt;• Acceptance at handover: no drift, controls compliant, POC account enrolled.&lt;br&gt;• Out of scope: Account Factory for Terraform, network hub account, Transit Gateway, Direct Connect." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontColor=#232F3E;spacing=2;" vertex="1" parent="1"><mxGeometry x="2015" y="1080" width="435" height="330" as="geometry"/></mxCell>
