{
  "name": "builder",
  "description": "Write-capable agent that writes plans, tests and code and runs the evidenced npm scripts and git.",
  "model": "auto",
  "tools": [
    "read",
    "grep",
    "glob",
    "write",
    "shell"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob"
  ],
  "resources": [
    "file://.kiro/steering/engineering-standards.md",
    "file://.kiro/steering/project-context.md",
    "file://.kiro/steering/core.md",
    "file://.kiro/steering/infra.md",
    "file://.kiro/steering/testing.md"
  ],
  "hooks": {
    "preToolUse": [
      {
        "command": "uv run python3 scripts/hooks/guard-answer-key.py",
        "matcher": "fs_write|execute_bash"
      },
      {
        "command": "uv run python3 scripts/hooks/block-aws-mutation.py",
        "matcher": "execute_bash"
      },
      {
        "command": "uv run python3 scripts/hooks/scan-secrets.py",
        "matcher": "fs_write|execute_bash"
      }
    ]
  }
}
